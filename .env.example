# Local development defaults. In Railway set NODE_ENV=production and TRUST_PROXY_HOPS=1.
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=

# Automatic configuration from the private details file.
# Preferred: keep all_details.txt at the project root (git-ignored, chmod 600),
# or set ALL_DETAILS_FILE to its absolute path. On Railway, set the single
# private variable ALL_DETAILS_TEXT to the full file contents instead of
# entering each value individually.
ALL_DETAILS_FILE=
ALL_DETAILS_TEXT=

# Optional explicit overrides (env wins over the details file).
SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

# Firebase Admin only. The Web SDK apiKey is not a server credential.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or set GOOGLE_APPLICATION_CREDENTIALS to a private service-account file path.

# Diagnostic/config fields only. Monetag stays disabled until its provider behavior is implemented and verified.
MONETAG_PUBLISHER_ID=
MONETAG_MAIN_ZONE_ID=
MONETAG_SDK_URL=
MONETAG_POSTBACK_SECRET=
MONETAG_POLICY_REVIEWED=false

# Hard-disabled in this build: no payment or payout adapter is implemented.
PAYMENT_PROVIDER=disabled
PAYOUT_PROVIDER=disabled
PAYMENT_CURRENCY=
PAYMENT_CURRENCY_EXPONENT=2
PAYMENT_MIN_DEPOSIT_MINOR=0
PAYMENT_MAX_DEPOSIT_MINOR=0
PAYMENT_MIN_WITHDRAWAL_MINOR=0
PAYMENT_MAX_WITHDRAWAL_MINOR=0

# Required for MFA-protected admin finance controls in production.
ADMIN_TOTP_SECRET=
ADMIN_TOTP_REQUIRED_FOR_FINANCE=true
TRUST_PROXY_HOPS=0

# Set to false to skip automatic Telegram menu-button setup at boot.
TELEGRAM_MENU_AUTO_SETUP=true
