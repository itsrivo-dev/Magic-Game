# Local development defaults. In Railway set NODE_ENV=production and TRUST_PROXY_HOPS=1.
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=
SESSION_SECRET=
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
ADMIN_TELEGRAM_ID=replace-with-trusted-telegram-user-id
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_MINI_APP_SHORT_NAME=

# Firebase Admin only. The Web SDK apiKey is not a server credential.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or set GOOGLE_APPLICATION_CREDENTIALS to a private file path.

# Optional Monetag runtime configuration. The SDK URL must be copied from the TMA dashboard.
MONETAG_PUBLISHER_ID=
MONETAG_MAIN_ZONE_ID=
MONETAG_SDK_URL=
MONETAG_POSTBACK_SECRET=

# Financial features stay disabled unless an external provider/manual process is configured and tested.
PAYMENT_PROVIDER=disabled
PAYOUT_PROVIDER=disabled
PAYMENT_CURRENCY=
PAYMENT_CURRENCY_EXPONENT=2
MANUAL_PAYMENT_INSTRUCTIONS=
PAYMENT_MIN_DEPOSIT_MINOR=0
PAYMENT_MAX_DEPOSIT_MINOR=0
PAYMENT_MIN_WITHDRAWAL_MINOR=0
PAYMENT_MAX_WITHDRAWAL_MINOR=0
ADMIN_TOTP_SECRET=
ADMIN_TOTP_REQUIRED_FOR_FINANCE=true
TRUST_PROXY_HOPS=0
